# p2p-multiple-groups Signaling Server Environment Configuration Example
# Copy to /etc/p2p-multiple-groups/signaling.env on the Azure VM and protect with:
#   sudo chown root:root /etc/p2p-multiple-groups/signaling.env
#   sudo chmod 600 /etc/p2p-multiple-groups/signaling.env

# Internal bind address and port (Node listens on loopback behind nginx HTTPS/WSS proxy)
P2P_SIGNAL_HOST=127.0.0.1
P2P_SIGNAL_PORT=8787
# (Legacy compatibility: KAZAA_SIGNAL_HOST and KAZAA_SIGNAL_PORT are also supported)

# Multi-Group Configuration (Recommended)
# Define one or more authenticated groups with distinct 32-byte base64url tokens.
# Tokens must NEVER be committed to git or exposed via unauthenticated endpoints.
P2P_GROUPS_JSON='[{"groupId":"group-alpha","token":"REPLACE_WITH_32_BYTE_BASE64URL_TOKEN_1","name":"Group Alpha"},{"groupId":"group-beta","token":"REPLACE_WITH_32_BYTE_BASE64URL_TOKEN_2","name":"Group Beta"}]'

# Single-Group Fallback (Used only when P2P_GROUPS_JSON is not specified)
KAZAA_ROOM_ID=classroom-network-1
KAZAA_ROOM_TOKEN=REPLACE_WITH_GENERATED_32_BYTE_BASE64URL_ROOM_TOKEN

# Public TURN relay configuration (coturn co-located on the same VM)
# Set to your Azure VM FQDN (<label>.<region>.cloudapp.azure.com)
P2P_TURN_HOST=p2p-demo.eastus.cloudapp.azure.com
# (Legacy: KAZAA_TURN_HOST supported)

# Server-only TURN authentication secret (used to sign dynamic 1-hour credentials via HMAC-SHA1)
# Must match the static-auth-secret in /etc/turnserver.conf
# NEVER share this secret with clients or commit to repository!
# Generate with:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
P2P_TURN_SECRET=REPLACE_WITH_GENERATED_32_BYTE_BASE64URL_TURN_SECRET
# (Legacy: KAZAA_TURN_SECRET supported)
