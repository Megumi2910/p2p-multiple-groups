# Coturn TURN/STUN Server Configuration Example for Kazaa P2P Helper
# Copy to /etc/turnserver.conf on the Azure VM and protect with:
#   sudo chown root:coturn /etc/turnserver.conf
#   sudo chmod 640 /etc/turnserver.conf

# Network interfaces
# Replace <PRIVATE_IPV4> with the VM's private IP (e.g. 10.0.0.4)
# Replace <PUBLIC_IPV4> with the Azure Standard static public IP
listening-ip=<PRIVATE_IPV4>
relay-ip=<PRIVATE_IPV4>
external-ip=<PUBLIC_IPV4>/<PRIVATE_IPV4>

# Ports:
# 3478: STUN (UDP/TCP)
# 5349: TURN over TLS (TCP)
listening-port=3478
tls-listening-port=5349

# Bounded UDP relay allocation port range (must match Azure NSG rules)
min-port=49160
max-port=49359

# Realm must equal the Azure FQDN
# Replace with your actual FQDN, e.g. kazaa-demo.eastus.cloudapp.azure.com
realm=<FQDN>

# Dynamic ephemeral authentication via server-only shared secret
# use-auth-secret implies long-term credential mechanism (do NOT also set lt-cred-mech)
use-auth-secret
static-auth-secret=REPLACE_WITH_GENERATED_32_BYTE_BASE64URL_TURN_SECRET

# Security & verification options
fingerprint
stale-nonce=600
no-multicast-peers
no-tcp-relay
no-cli

# Rate limiting and quota bounds
user-quota=16
total-quota=128
max-bps=1048576       # 1 MiB/s per allocation bandwidth limit
bps-capacity=8388608  # 8 MiB/s total server bandwidth capacity

# TLS Certificates (managed and renewed via certbot hook)
cert=/etc/coturn/certs/turn_server_cert.pem
pkey=/etc/coturn/certs/turn_server_pkey.pem
cipher-list="ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384"

# Denied relay targets: prevent SSRF, loopback attacks, and cloud metadata access
# Keep the VM's public IPv4 allowed so two relayed peers can connect through this server!
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=169.254.0.0-169.254.255.255       # Cloud instance metadata service (169.254.169.254)
denied-peer-ip=168.63.129.16                     # Azure platform virtual network resolver
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

# Logging: do not log credentials or user data
simple-log
log-file=/var/log/coturn/turnserver.log
no-stdout-log
verbose=0
