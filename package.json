{
  "name": "p2p-multiple-groups",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --test tests/theme-store.test.ts && node --test tests/p2p-protocol.test.ts && node --test tests/p2p-integration.test.ts && node --test tests/p2p-transfers.test.ts",
    "build": "npm run typecheck && electron-vite build",
    "signal:start": "node --env-file-if-exists=.env services/signaling/index.ts",
    "signal:invite": "node --env-file-if-exists=.env scripts/create-invite.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "werift": "^0.24.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.1",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
